# Build output.
# "out" and "build" are anchored to the repository root on purpose: in hexagonal
# architecture "out" is a source package (application/port/out, adapters/out), so an
# unanchored out/ rule silently excludes real code from every commit.
target/
/out/
/build/
TennisPlatformApp/out/
TennisPlatformApp/build/

# Secrets and local environment (.env.example IS tracked, as the documented template)
.env
.env.local
*.env
!.env.example

# IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/

# Claude Code: the shared config and hooks ARE tracked, personal overrides are not
.claude/settings.local.json

# Logs
*.log
logs/

# OS noise
Thumbs.db
Desktop.ini
.DS_Store
