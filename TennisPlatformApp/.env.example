# Copy to .env and adjust. Never commit the real .env.
# The dev profile falls back to these same values when the variables are absent,
# so compose works out of the box without a .env file.

DB_NAME=tennis_platform
DB_USER=tennis_platform
DB_PASSWORD=tennis_platform
DB_PORT=5432

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Development mailbox (web UI on MAILPIT_UI_PORT).
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# At least 32 characters. Production must set a real, private value.
JWT_SECRET=dev-only-insecure-secret-change-me-32-bytes-min

# The single teacher, created at startup. Leave the credentials blank and no teacher is
# created: nothing is ever seeded by accident. They are read from the environment and never
# from a Liquibase changeset, because a changelog is a file in a published repository and a
# password - or its hash - would stay in the Git history forever.
# TEACHER_TIMEZONE is an IANA id and is the reference for every lesson shown in local time.
TEACHER_EMAIL=
TEACHER_PASSWORD=
TEACHER_DISPLAY_NAME=
TEACHER_TIMEZONE=Europe/Madrid

# The first administrator, created at startup. Never registered publicly.
ADMIN_EMAIL=
ADMIN_PASSWORD=
