# Production environment for compose.prod.yaml. On the server:
#   cp deploy/.env.prod.example .env && chmod 600 .env
# then fill every value. Never commit the real file. The prod profile has no defaults: a
# missing value stops the backend at startup and the log names it.

# Your domain, without www or app. The app is served at https://app.<DOMAIN>.
DOMAIN=example.com

DB_NAME=tennis_platform
DB_USER=tennis_platform
# openssl rand -base64 32 | tr -d '/+='
DB_PASSWORD=

# At least 32 characters, random and private: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# SMTP of a transactional provider (e.g. Brevo: smtp-relay.brevo.com, 587).
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# The single teacher and the first administrator, created at startup.
TEACHER_EMAIL=
TEACHER_PASSWORD=
TEACHER_DISPLAY_NAME=
TEACHER_TIMEZONE=Europe/Madrid
ADMIN_EMAIL=
ADMIN_PASSWORD=

AUTH_RATE_LIMIT_PER_MINUTE=20

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> the token after --token.
TUNNEL_TOKEN=
