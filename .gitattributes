# Normalize text files to LF inside the repository. Windows checkouts still work,
# and files copied into Linux containers do not arrive with CRLF.
* text=auto eol=lf

# Binaries must never be line-ending normalized - doing so corrupts them.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.jar binary
*.woff binary
*.woff2 binary

# Windows-only scripts genuinely need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
